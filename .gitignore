# ==============================================================================
# UniformApp — .gitignore (Java 25 / Quarkus 3 / Angular 21)
# ==============================================================================

# Maven & Quarkus build outputs
target/
!.mvn/wrapper/maven-wrapper.jar
**/src/main/**/target/
**/src/test/**/target/

# Angular & Node.js
frontend/node_modules/
frontend/dist/
frontend/.angular/
frontend/.wrangler/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Logs & runtime files
logs/
*.log
*.pid

# IDE & OS
.idea/
*.iml
.vscode/
.DS_Store
ThumbsOf.db
